{
  "manifest_version": 3,
  "name": "Gmail AI Smart Voice Agent",
  "version": "1.0",
  "description": "Smart Multilingual Voice Agent to draft professional Gmails automatically.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}